{
  "name": "jabberlm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "author": "Greg Dickason",
  "scripts": {
    "build:guide": "node scripts/build-guide.mjs",
    "gen:jabber": "npx --yes vite-node scripts/gen-model.ts",
    "gen:sonnets": "DATASET=sonnets npx --yes vite-node scripts/gen-model.ts",
    "gen:multitask": "DATASET=multitask npx --yes vite-node scripts/gen-model.ts",
    "gen:moe": "DATASET=moe npx --yes vite-node scripts/gen-model.ts",
    "gen:harness": "DATASET=harness npx --yes vite-node scripts/gen-model.ts",
    "gen:sort": "DATASET=sort npx --yes vite-node scripts/gen-model.ts",
    "gen:multitask-draft": "DATASET=multitask-draft STEPS=3000 npx --yes vite-node scripts/gen-model.ts",
    "gen:warehouse": "DATASET=warehouse STEPS=3500 npx --yes vite-node scripts/gen-model.ts",
    "gen:tictactoe": "DATASET=tictactoe STEPS=2000 BATCH=16 LR=0.003 ROUND_DP=6 npx --yes vite-node scripts/gen-model.ts",
    "gen:tictactoe-strong": "DATASET=tictactoe-strong STEPS=4000 BATCH=16 LR=0.002 ROUND_DP=6 CHECKPOINT_EVERY=1000 npx --yes vite-node scripts/gen-model.ts",
    "dev": "npm run build:guide && vite",
    "build": "npm run build:guide && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "marked": "^18.0.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
